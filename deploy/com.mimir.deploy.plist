<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent that polls origin/main and redeploys on change.

  This is a TEMPLATE. Before installing on the server, replace the three paths
  marked "CHANGE" with the server user's home and the repo location, then copy
  it to ~/Library/LaunchAgents/. See deploy/README.md for full steps.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mimir.deploy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- CHANGE: absolute path to deploy.sh in your clone -->
        <string>/Users/sven/dev/mimir/scripts/deploy.sh</string>
    </array>

    <!-- Poll every 120 seconds; also run once immediately when loaded. -->
    <key>StartInterval</key>
    <integer>120</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- CHANGE: the server user's home directory -->
        <key>HOME</key>
        <string>/Users/sven</string>
    </dict>

    <!-- CHANGE: log path (must be absolute; ~ is not expanded here) -->
    <key>StandardOutPath</key>
    <string>/Users/sven/Library/Logs/mimir-deploy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sven/Library/Logs/mimir-deploy.log</string>
</dict>
</plist>
